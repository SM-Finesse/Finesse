# 이 파일을 같은 폴더에 .env 로 복사한 뒤 PC에 맞게 수정 (.env 는 git에 올리지 않음)

# 이 PC에서 띄울 것: backend / frontend / backend,frontend(리허설·한 대 운영)
COMPOSE_PROFILES=backend,frontend

# 포트 (PC에서 이미 쓰는 포트와 겹치면 바꿈)
BACKEND_PORT=8081
FRONTEND_PORT=80

# 프론트(Nginx)가 /api 를 넘길 백엔드 주소
#   같은 PC: http://backend:8081   /   다른 PC: http://192.168.0.126:8081
BACKEND_UPSTREAM=http://backend:8081

# 백엔드가 부를 LLM 서버 (쉼표 구분)
LLM_SERVERS=http://192.168.0.111:8081,http://192.168.0.113:8081

# ---- 아래는 보통 건드리지 않음 ----
# 배포할 태그를 읽어 올 곳 (GitHub deploy 브랜치)
# TARGET_URL=https://raw.githubusercontent.com/SM-Finesse/Finesse/deploy/target.env
# 배포 후 정상 확인 대기 시간(초)
# HEALTH_TIMEOUT_SEC=180
