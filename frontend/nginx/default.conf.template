# Finesse frontend Nginx 설정 (템플릿 — ${BACKEND_UPSTREAM} 은 컨테이너 시작 시 치환됨)
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---- API → backend 프록시 ----
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # heavy 뷰는 SSE(EventSource)로 챕터를 받아온다 → 버퍼링을 끄지 않으면
        # 챕터가 하나씩 오지 않고 끝날 때 한꺼번에 도착함
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;

        # light 코멘트는 LLM 생성이라 수십 초 걸릴 수 있음 (Nginx 기본 60초보다 넉넉하게)
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- 해시가 붙은 빌드 산출물은 오래 캐시 ----
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ---- SPA: 없는 경로는 index.html로 (index.html 자체는 캐시하지 않음) ----
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
